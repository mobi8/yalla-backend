            "RESULT_POLICY": "PERMISSIVE",
            "GAME_CONFIG_BUCKET": "yalla-result-pools-533266967583",
            "RESULT_POOL_BUCKET": "yalla-result-pools-533266967583",
            "RESULT_POOL_PREFIX": "result-pools/v1/",
            "PHYSICS_VERSION": "fixed-fresh-round-v1",
            "COGNITO_ISSUER": {
              "Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${UserPool}"
            }
          }
        }
      }
    },
    "PlayerIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "PlayerFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0"
      }
    },
    "PlayerPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "PlayerFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/*/*"
        }
      }
    },
    "AuthGuestRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "RouteKey": "POST /auth/guest",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "AuthIntegration"
              }
            ]
          ]
        },
        "AuthorizationType": "NONE"
      }
    },
    "AuthRefreshRoute": {
